{
  "name": "Tabaru",
  "version": "0.10.1",
  "description": "Quick and simple tab management",
  "author": "Sonu Sharma",
  "manifest_version": 3,
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' https: data:; connect-src https:; base-uri 'self';"
  },
  "__chrome|edge|opera__permissions": [
    "storage",
    "tabs",
    "tabGroups",
    "sessions",
    "activeTab",
    "scripting",
    "idle",
    "search",
    "bookmarks",
    "favicon",
    "topSites"
  ],
  "__firefox__permissions": [
    "storage",
    "tabs",
    "sessions",
    "activeTab",
    "scripting",
    "idle",
    "search",
    "bookmarks",
    "topSites"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_icon": {
      "16": "images/icon-16.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
    }
  },
  "icons": {
    "16": "images/icon-16.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "background": {
    "__chrome|edge|opera__service_worker": "scripts/background.js",
    "__chrome|edge|opera__type": "module",
    "__firefox__scripts": [
      "scripts/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["scripts/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "styles/*",
        "images/*",
        "*.wasm"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "kill_tab": {
      "suggested_key": {
        "default": "Alt+W"
      },
      "description": "tab: close current tab"
    },
    "open_and_close_search": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "tab: search open & close modal"
    },
    "move_tab_left": {
      "description": "tab: move left"
    },
    "move_tab_right": {
      "description": "tab: move right"
    },
    "next_tab": {
      "suggested_key": {
        "default": "Alt+X"
      },
      "description": "tab: next"
    },
    "prev_tab": {
      "suggested_key": {
        "default": "Alt+Z"
      },
      "description": "tab: previous"
    },
    "next_win": {
      "description": "window: next"
    },
    "prev_win": {
      "description": "window: previous"
    }
  }
}
