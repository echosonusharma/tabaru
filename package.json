{
  "name": "tabaru",
  "version": "v1.0.33",
  "description": "Quick and simple tab management",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "npm run build:wasm:release && webextension-toolbox build",
    "dev": "npm run build:wasm && webextension-toolbox dev",
    "release:patch": "node ./scripts/tag_to_manifest.js patch",
    "release:minor": "node ./scripts/tag_to_manifest.js minor",
    "release:major": "node ./scripts/tag_to_manifest.js major",
    "unpack": "bash ./scripts/unpack_zip.sh",
    "build:wasm": "wasm-pack build ld-wasm-lib --target web",
    "build:wasm:release": "wasm-pack build ld-wasm-lib --target web --release"
  },
  "keywords": [],
  "author": "Sonu Sharma",
  "devDependencies": {
    "@types/chrome": "^0.1.32",
    "@types/webextension-polyfill": "^0.12.4",
    "@webextension-toolbox/webextension-toolbox": "^7.1.1",
    "babel-loader": "^10.0.0",
    "css-loader": "^7.1.2",
    "semver": "^7.7.3",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "uuid": "^11.1.1",
    "webpack-dev-server": "^5.2.4",
    "webpackbar": "^7.0.0"
  },
  "dependencies": {
    "ld-wasm-lib": "file:ld-wasm-lib/pkg",
    "preact": "^10.29.0",
    "webextension-polyfill": "^0.12.0"
  }
}
